# Path to the SBD library
SBD_PATH=../..

# mpi c++ compiler
CCCOM=mpicxx

### MSU ICER: NVHPC + CUDA (GPU via Thrust)
### Modules: NVHPC/23.7-CUDA-12.1.1, OpenMPI/4.1.5-NVHPC-23.7-CUDA-12.1.1,
###          FlexiBLAS/3.3.1-NVHPC-23.7-CUDA-12.1.1
### For A100 (SM 80): -gpu=cc80
### For H200 (SM 90): -gpu=cc90
CCFLAGS= -mp -cuda -fast --diag_suppress declared_but_not_referenced,set_but_not_used -gpu=cc80 -DSBD_THRUST
SYSLIB= -lflexiblas

